---
import type { CollectionEntry } from "astro:content";
import Default from "./Default.astro";
import FormattedDate from "../components/FormattedDate.astro";
import "../styles/typography.css";

type PartialBy<T, K extends keyof T> = Omit<T, K> & Partial<Pick<T, K>>;

type Props = PartialBy<CollectionEntry<"blog">["data"], "pubDate"> & {
  slug: string;
};

const { title, forceTheme, description, pubDate, updatedDate, heroImage } =
  Astro.props;
---

<Default {title} {description} {forceTheme} section="blog">
  <main class="mt-24 pb-24">
    <article>
      <div class="hero-image">
        {heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
      </div>
      <div class="prose dark:prose-invert">
        <div class="title mb-16">
          <h1
            class="font-merriweather mb-3! text-3xl! font-black! text-violet-900! sm:text-4xl! dark:text-violet-200!"
          >
            {title}
          </h1>

          <div class="date text-sm">
            {pubDate && <FormattedDate date={pubDate} />}
            {
              updatedDate && (
                <div class="last-updated-on">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </div>
        </div>

        <slot />
      </div>
    </article>
  </main>
</Default>
