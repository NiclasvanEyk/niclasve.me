---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import SiteContainer from "@/components/SiteContainer.astro";
import { themes, type ThemeName } from "@/theme";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  root?: true;
  forceTheme?: "light" | "dark";
  section?: ThemeName;
}

const props = Astro.props;

// OpenGraph cards are generated at build time in `/og`, mirroring the page
// path: `/projects/keepac` -> `/og/projects/keepac.png`. Pages without a card
// (like the 404 page) pass an explicit `image`.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const image =
  props.image ?? (pathname === "/" ? "/og/home.png" : `/og${pathname}.png`);

let htmlAttrs = {};

if (props.forceTheme) {
  htmlAttrs = {
    "data-theme": `${props.forceTheme}-plus`,
    // The strings need to appear here, in order for tailwind to pick them up
    class: props.forceTheme === "dark" ? "dark" : "light",
  };
}
---

<!doctype html>
<html lang="en" {...htmlAttrs}>
  <head>
    <BaseHead
      title={props.title ?? SITE_TITLE}
      description={props.description ?? SITE_DESCRIPTION}
      {image}
    />
  </head>
  <body class="px-6 text-zinc-900 xl:px-0 dark:text-zinc-200">
    <Header root={props.root} section={props.section} />

    <SiteContainer data-section={props.section && themes[props.section].section}>
      <slot />
    </SiteContainer>
  </body>
</html>
