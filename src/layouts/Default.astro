---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import SiteContainer from "@/components/SiteContainer.astro";
import type { Landmark } from "@/landmarks";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
  root?: true;
  forceTheme?: "light" | "dark";
  section?: Landmark;
}

const props = Astro.props;
let htmlAttrs = {};

if (props.forceTheme) {
  htmlAttrs = {
    "data-theme": `${props.forceTheme}-plus`,
    // The strings need to appear here, in order for tailwind to pick them up
    class: props.forceTheme === "dark" ? "dark" : "light",
  };
}
---

<!doctype html>
<html lang="en" {...htmlAttrs}>
  <head>
    <BaseHead
      title={props.title ?? SITE_TITLE}
      description={props.description ?? SITE_DESCRIPTION}
    />
  </head>
  <body
    class="px-6 text-zinc-900 xl:px-0 dark:text-zinc-200"
  >
    <Header root={props.root} section={props.section} />

    <SiteContainer data-section={props.section}>
      <slot />
    </SiteContainer>
  </body>
</html>
