---
import Default from "@/layouts/Default.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { project as projectPage } from "@/links";
import { format } from "date-fns";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.startedAt.valueOf() - a.data.startedAt.valueOf(),
);
---

<Default title="Projects · niclasve.me">
  <main data-section="projects" class="mt-24 pb-24">
    <SectionHeading theme="projects" size="page" />

    <p class="my-3">
      This is basically a cleaner version of <a
        class="underline"
        href="https://github.com/NiclasvanEyk?tab=repositories"
        >my repository list on GitHub</a
      >.
    </p>

    <table>
      <tbody>
        {
          projects.map((project) => (
            <tr>
              <td class="whitespace-nowrap py-1 align-top tabular-nums opacity-50">
                {format(project.data.startedAt, "yyyy-MM-dd")}
              </td>
              <td class="px-3 py-1">
                <a href={projectPage(project.id.replace(/\.md$/, ""))} class="hover:underline">
                  {project.data.title}
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Default>
