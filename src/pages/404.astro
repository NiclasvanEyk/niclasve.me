---
import GlyphBadge from "@/components/GlyphBadge.astro";
import Default from "@/layouts/Default.astro";
---

<Default title="Not Found · niclasve.me" image="/og/home.png">
  <main data-section="not-found" class="mt-24 pb-24">
    <GlyphBadge
      theme="notFound"
      label="A very confused badge"
      size="large"
    />
    <p class="mt-8 font-mono text-sm text-[var(--link-color)]">404</p>
    <h1
      class="font-merriweather mt-2 text-3xl font-black tracking-tight section-heading"
    >
      Not Found
    </h1>
    <p class="mt-3">This page does not seem to exist.</p>
    <a href="/" class="mt-6 inline-block underline underline-offset-4"
      >Back to the homepage</a
    >
  </main>
</Default>
