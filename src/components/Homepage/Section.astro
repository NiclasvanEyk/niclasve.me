---
import type { HTMLAttributes } from "astro/types";
import SectionHeading from "@/components/SectionHeading.astro";
import type { Landmark } from "@/landmarks";

type Props = HTMLAttributes<"section"> & {
  heading: string;
  headingClass?: string;
  href?: string;
  glyph?: string;
  glyphClass?: string;
  transitionName?: string;
  section?: Landmark | "welcome" | "socials";
};

const {
  heading,
  headingClass,
  glyph,
  glyphClass,
  href,
  transitionName,
  section,
  class: className,
  ...props
} = Astro.props;
---

<section data-section={section} class:list={[className]} {...props}>
  <header class="mb-1">
    <SectionHeading
      {heading}
      {headingClass}
      {glyph}
      {glyphClass}
      {href}
      {transitionName}
    />
  </header>

  <div class="text-base">
    <slot />
  </div>
</section>
