---
import type { CollectionEntry } from "astro:content";
import { project as projectPage } from "@/links";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
---

<li
  class="group block md:min-h-full rounded p-4 transition-colors hover:bg-red-800/5 dark:hover:bg-red-200/10"
>
  <a
    href={projectPage(project.id.replace(/\.md$/, ""))}
    class="relative block font-bold group-hover:underline"
  >
    <span>
      {project.data.title}
    </span>
  </a>
  <p class="cursor-default opacity-75">
    {project.data.description}
  </p>
</li>
