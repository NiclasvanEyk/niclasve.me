---
import { SITE_TITLE } from "../consts";
import SectionHeading from "./SectionHeading.astro";
import type { ThemeName } from "@/theme";

interface Props {
  root?: true;
  section?: ThemeName;
}

const { section, root } = Astro.props;
const titleClasses = "py-3 text-zinc-900/80 dark:text-zinc-100/60";
---

<header class="flex flex-row place-content-center">
  <nav
    aria-label="Main"
    class="flex w-full max-w-3xl flex-wrap items-center gap-x-3"
  >
    {
      root ? (
        <span class:list={[titleClasses, "cursor-default"]}>{SITE_TITLE}</span>
      ) : (
        <a href="/" class={titleClasses}>
          {SITE_TITLE}
        </a>
      )
    }

    {
      section && (
        <>
          <span aria-hidden="true" class="text-zinc-400 dark:text-zinc-600">
            ⋅
          </span>
          <SectionHeading theme={section} size="nav" />
        </>
      )
    }
  </nav>
</header>
