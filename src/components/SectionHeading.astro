---
import GlyphBadge from "./GlyphBadge.astro";
import { themes, type ThemeName, type SectionTheme } from "@/theme";

interface Props {
  theme: ThemeName;
  size?: "section" | "page" | "nav";
}

const { theme, size = "section" } = Astro.props;
const { heading, href, section, transitionName }: SectionTheme = themes[theme];
const Wrapper = size === "nav" ? "span" : "div";
const Heading = size === "page" ? "h1" : size === "nav" ? "span" : "h2";
const headingClasses = "section-heading font-black tracking-tight opacity-95";
const isLinkedHeading = Boolean(href) && size === "section";
---

<Wrapper
  data-section={section}
  class:list={[
    "font-merriweather flex w-fit max-w-full items-center",
    size === "page" ? "gap-3 text-2xl" : "gap-2 text-base",
  ]}
  transition:name={transitionName}
>
  <GlyphBadge
    {theme}
    label={`${heading} badge`}
    size={size === "page" ? "medium" : "small"}
  />
  {
    size === "nav" ? (
      <a href={href} class="flex items-center hover:underline">
        <Heading class={headingClasses}>{heading}</Heading>
      </a>
    ) : isLinkedHeading ? (
      <Heading class={headingClasses}>
        <a href={href} class="text-inherit hover:underline">
          {heading}
        </a>
      </Heading>
    ) : (
      <Heading class={headingClasses}>{heading}</Heading>
    )
  }
</Wrapper>
